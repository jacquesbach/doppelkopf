# =====================================================================================
# Zentrale Einstellungen. Kopieren nach ".env" (liegt NICHT im Git) und Werte eintragen:
#     cp .env.example .env
# - Docker Compose liest ".env" automatisch.
# - Auf dem Server schreibt GitHub Actions diese Datei bei jedem Deploy aus den GitHub-Secrets/-Variablen
#   (siehe docs/DEPLOYMENT.md). Hier lokal gepflegt, dort in GitHub.
# - Ohne Docker (python run.py / npm run dev): vorher laden, z. B.  set -a; source .env; set +a
# =====================================================================================

# ---- GEHEIM (nie ins Git, in GitHub als "Secret") -------------------------------------
# Signiert Captcha und Betreiber-Anmeldung, hasht Daumen-Kennungen. Erzeugen:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Wird der Wert geaendert, melden sich alle Betreiber ab und offene Captchas werden ungueltig.
SECRET_KEY=

# Passwort fuer das Betreiber-Backend unter /admin. Leer = Backend abgeschaltet. In Produktion mind. 10 Zeichen.
ADMIN_PASSWORD=

# ---- Ports (in GitHub als "Variable") --------------------------------------------------
# Oeffentlicher Port des Frontends (nginx im Container hoert intern auf 80).
FRONTEND_PORT=8080
# Port des Backends (Flask). nginx und Healthcheck nutzen denselben Wert; "npm run dev" leitet ebenfalls dorthin.
BACKEND_PORT=8181
# Auf welcher Adresse der Server den Backend-Port oeffnet. 127.0.0.1 = nur lokal (empfohlen, Besucher gehen ueber das Frontend);
# 0.0.0.0 = von aussen erreichbar.
BACKEND_BIND=127.0.0.1

# ---- Domain und Suchmaschinen ----------------------------------------------------------
# Adresse der Website mit https:// und ohne Schrägstrich am Ende. Daraus entstehen canonical-Links, sitemap.xml, robots.txt
# und die Link-Vorschau. Wird beim BUILD eingelesen (Docker-Build-Argument). In GitHub als Variable "SITE_URL".
SITE_URL=https://doppelkopf.cc

# ---- Sonstiges ---------------------------------------------------------------------------
# production verlangt ein gesetztes SECRET_KEY und (falls ADMIN_PASSWORD gesetzt) mind. 10 Zeichen.
APP_ENV=production
# Erlaubte Browser-Ursprunge, kommagetrennt. "*" ist hinter dem nginx-Proxy noetig (Socket.IO, siehe backend/README.md).
CORS_ORIGINS=*
# Basis-URL der API, die das Frontend beim BUILD einliest. "/api" = gleicher Ursprung (nginx bzw. Vite-Proxy).
VITE_API_BASE_URL=/api
# Name des Docker-Projekts (bestimmt u. a. den Namen des Daten-Volumes "<name>_doppelkopf-data").
# Bei einer bereits laufenden Installation den bisherigen Namen eintragen, sonst startet die Datenbank leer.
COMPOSE_PROJECT_NAME=doppelkopf

# Neue Tische je Besucheradresse und Stunde (Schutz vor Missbrauch). Leer = 30.
CREATE_PER_HOUR=

# Anzeige im Betreiber-Dashboard (Systemstatus). Setzt der Deploy automatisch; lokal leer lassen oder von Hand eintragen.
APP_VERSION=
DEPLOYED_AT=

# ---- Impressum und Datenschutz -------------------------------------------------------------
# Diese Angaben stehen NICHT in der .env, sondern in der Datei legal/legal.json (Vorlage: deploy/legal.example.json).
# Auf dem Server erzeugt GitHub Actions sie aus den Variablen LEGAL_NAME, LEGAL_STREET, LEGAL_CITY, LEGAL_EMAIL, ...
# (docs/DEPLOYMENT.md). Ohne die Datei zeigt die Seite markierte Testdaten.

