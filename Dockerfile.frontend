FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
# Mit package-lock.json reproduzierbar (npm ci), sonst npm install
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi
COPY . .
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
# Domain der Website (canonical, sitemap.xml, robots.txt, og:url); leer = https://doppelkopf.cc
ARG VITE_SITE_URL=
ENV VITE_SITE_URL=$VITE_SITE_URL
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
# Als Vorlage ablegen: das nginx-Image ersetzt ${BACKEND_PORT} beim Start (siehe docker-compose.yml)
COPY deploy/nginx.conf /etc/nginx/templates/default.conf.template
EXPOSE 80
